---
import SVG from "./SVG.astro";

const services = [
  { title: "Graphic Design", color: "blue" },
  { title: "UI/UX", color: "yellow" },
  { title: "Apps", color: "pink" },
  { title: "Illustrations", color: "primary" },
  { title: "Photography", color: "cyan" },
  {
    title: "Motion Graphics",
    color: "purple",
  },
];
---

<section class="hero">
  <div class="container">
    <div class="hero__text">
      <h1>Design solutions made easy</h1>
      <p>
        With over ten years of experience in various design disciplines, I’m
        your one-stop shop for your design needs.
      </p>
    </div>
    <div class="hero__services">
      <h2 aria-hidden="true">Services</h2>
      <ul class="services-list">
        {
          services.map((service) => (
            <li class:list={["services-item", `bg-${service.color}`]}>
              <div class="icon">
                <SVG name={service.title} />
              </div>
              <h3>{service.title}</h3>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style lang="scss">
  $hero-spacing: clamp(2.5rem, -0.3571rem + 5.9524vw, 5rem);

  .hero__services {
    h2 {
      @include visually-hidden;
    }
  }

  .hero {
    padding-top: $hero-spacing;

    &__text {
      @include flex-center;
      flex-direction: column;
      gap: 1.25rem;
      text-align: center;
    }
  }

  .services {
    &-list {
      align-items: stretch;
      display: grid;
      gap: clamp(1.25rem, 0.9643rem + 0.5952vw, 1.5rem);
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 182px;

      @include bp(md) {
        grid-template-columns: repeat(4, 1fr);
      }

      @include bp(lg) {
        grid-template-columns: repeat(6, 1fr);
      }
    }

    &-item {
      border-radius: 8px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 1.25rem;

      h3 {
        color: var(--color-body-text-light);
      }

      &:nth-child(1) {
        grid-column: 1 / span 2;
        grid-row: 1 / span 2;
      }

      &:nth-child(4),
      &:nth-child(5),
      &:nth-child(6) {
        grid-column: span 2;
      }
    }
  }

  .bg- {
    &blue {
      background-color: var(--color-blue);
    }
    &purple {
      background-color: var(--color-purple);
    }
    &cyan {
      background-color: var(--color-cyan);
    }
    &pink {
      background-color: var(--color-pink);
    }
    &yellow {
      background-color: var(--color-yellow);
    }

    &primary {
      background-color: var(--color-primary);
    }
  }

  .container {
    display: grid;
    gap: $hero-spacing;
  }
</style>
