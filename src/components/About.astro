---
import { Image } from "astro:assets";

import aboutImage from "@assets/images/image-amy.webp";
---

<section class="about">
  <div class="container">
    <div class="about__image">
      <Image
        src={aboutImage}
        alt="Amy headshot"
      />
    </div>
    <div class="about__content">
      <h2>I'm Amy, and I'd love to work on your next project</h2>
      <p>
        I love working with others to create beautiful design solutions. I’ve
        designed everything from brand illustrations to complete mobile apps.
        I’m also handy with a camera!
      </p>
      <a
        href="/"
        class="btn btn--primary"
      >
        Free Consultation
      </a>
    </div>
  </div>
</section>

<style lang="scss">
  .container {
    @include flex-center;
    flex-direction: column;
    gap: 1.5rem;
    text-align: center;

    @include bp(lg) {
      flex-direction: row;
      justify-content: space-between;
      text-align: start;
    }
  }

  .about {
    &__image {
      max-width: clamp(18.75rem, 8.3929rem + 21.5774vw, 27.8125rem);
    }
    &__content {
      align-items: center;
      display: flex;
      flex-direction: column;
      gap: 2rem;

      @include bp(lg) {
        align-items: start;
        flex-shrink: 0;
        max-width: 540px;
      }
    }
  }
</style>
